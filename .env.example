# Contact form backend. Copy this file to .env.local (never commit
# .env.local) and add the same values in Vercel -> Settings -> Environment
# Variables. All keys are server-only: never prefix them with NEXT_PUBLIC_.
# With nothing set, the form says online sending isn't set up yet and
# shows the email address. It never fakes a send.

# --- Storage: Supabase (https://supabase.com) -------------------------
# Project URL: Dashboard -> Project Settings -> Data API.
SUPABASE_URL=
# Secret key (sb_secret_...) or legacy service_role key:
# Dashboard -> Project Settings -> API Keys. Keep it private.
SUPABASE_SECRET_KEY=

# --- Email notifications: Resend (https://resend.com) -----------------
# API key from the Resend dashboard (starts with "re_").
RESEND_API_KEY=
# Inbox notified about new messages. Defaults to the site email if empty.
CONTACT_TO_EMAIL=
# Verified sender, e.g. "Portfolio <hello@yourdomain.com>". If empty,
# Resend's test sender (onboarding@resend.dev) is used, which can only
# deliver to the email address of the Resend account owner.
CONTACT_FROM_EMAIL=
