# Contact form email delivery (Resend, https://resend.com).
# Copy this file to .env.local (never commit .env.local) and fill in values.
# Without RESEND_API_KEY the form tells visitors that online sending isn't
# set up yet and shows the email address instead. It never fakes a send.

# Server-only API key from the Resend dashboard (starts with "re_").
RESEND_API_KEY=

# Inbox that receives messages. Defaults to the site email if empty.
CONTACT_TO_EMAIL=

# Verified sender, e.g. "Portfolio <hello@yourdomain.com>". If empty,
# Resend's test sender (onboarding@resend.dev) is used, which can only
# deliver to the email address of the Resend account owner.
CONTACT_FROM_EMAIL=
